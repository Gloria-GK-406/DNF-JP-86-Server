<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- A real host, to say when the notification registry is asked for relative to the first
         hosted service starting. Three sibling test projects already take this dependency. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dfo.Server.Application\Dfo.Server.Application.csproj" />
    <ProjectReference Include="..\..\src\Dfo.Server.Protocol\Dfo.Server.Protocol.csproj" />
    <!--
      Infrastructure is referenced so the entry rules can run against the real archive
      rather than only against stub definitions. Stubbing both sides of the content
      interface would leave the archive-to-rule path unproven, which is the gap that let an
      earlier attempt at this outcome look complete while being empty. Networking's test
      project already pairs these two references the same way. Production layering is
      unaffected: the rule that Application must not depend on Infrastructure is asserted
      against Server/src, not against test projects.
    -->
    <ProjectReference Include="..\..\src\Dfo.Server.Infrastructure\Dfo.Server.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Dfo.Server.Persistence\Dfo.Server.Persistence.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compiled in rather than copied: three test assemblies reach the inventory seam, and this
         is the one description of how the server wires it. -->
    <Compile Include="..\Dfo.Server.Persistence.Tests\Support\InventorySide.cs"
             Link="Support\InventorySide.cs" />
    <Compile Include="..\Dfo.Server.Persistence.Tests\Support\VolatileItemDomainStore.cs"
             Link="Support\VolatileItemDomainStore.cs" />
  </ItemGroup>

</Project>
