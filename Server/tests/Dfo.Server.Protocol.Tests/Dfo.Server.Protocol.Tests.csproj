<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dfo.Server.Application\Dfo.Server.Application.csproj" />
    <ProjectReference Include="..\..\src\Dfo.Server.Infrastructure\Dfo.Server.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Dfo.Server.Persistence\Dfo.Server.Persistence.csproj" />
    <ProjectReference Include="..\..\src\Dfo.Server.Protocol\Dfo.Server.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      One character's progress, held in memory. Shared with the Application tests by link rather
      than copied: two copies of a double drift, and the drift is invisible until one of them
      quietly stops matching the interface the other is proving something about. There is no
      shared test-support project, and one double does not earn creating one.
    -->
    <Compile Include="..\Dfo.Server.Application.Tests\Support\CurrentCharacterStub.cs" Link="Support\CurrentCharacterStub.cs" />
    <Compile Include="..\Dfo.Server.Application.Tests\Support\NoticeStateStub.cs" Link="Support\NoticeStateStub.cs" />
    <Compile Include="..\Dfo.Server.Application.Tests\Support\RecordingCharacterTable.cs"
             Link="Support\RecordingCharacterTable.cs" />
    <Compile Include="..\Dfo.Server.Application.Tests\Support\RecordingQuestLogs.cs"
             Link="Support\RecordingQuestLogs.cs" />
    <Compile Include="..\Dfo.Server.Application.Tests\Support\StubWorldContentEntryRuleService.cs"
             Link="Support\StubWorldContentEntryRuleService.cs" />
    <Compile Include="..\Dfo.Server.Application.Tests\Support\LegacyTownAreaTestAdapter.cs"
             Link="Support\LegacyTownAreaTestAdapter.cs" />
    <Compile Include="..\Dfo.Server.Application.Tests\Support\DungeonRunTestEntryExtensions.cs"
             Link="Support\DungeonRunTestEntryExtensions.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Compiled in rather than copied: three test assemblies reach the inventory seam, and this
         is the one description of how the server wires it. -->
    <Compile Include="..\Dfo.Server.Persistence.Tests\Support\BagRewardDelivery.cs" Link="Support\BagRewardDelivery.cs" />
    <Compile Include="..\Dfo.Server.Persistence.Tests\Support\InventorySide.cs"
             Link="Support\InventorySide.cs" />
    <Compile Include="..\Dfo.Server.Persistence.Tests\Support\VolatileItemDomainStore.cs" Link="Support\VolatileItemDomainStore.cs" />
    <Compile Include="..\Dfo.Server.Persistence.Tests\Support\CharacterSide.cs"
             Link="Support\CharacterSide.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Support/PvfAttributes.cs" Link="Support/PvfAttributes.cs" />
    <Compile Include="../Support/TestSessions.cs" Link="Support/TestSessions.cs" />
    <Compile Include="../Support/TestGameplay.cs" Link="Support/TestGameplay.cs" />
    <Compile Include="../Support/GameplayAssertionRecorder.cs" Link="Support/GameplayAssertionRecorder.cs" />
    <Compile Include="../Support/GameplayAssertionRecorderControlTests.cs" Link="Support/GameplayAssertionRecorderControlTests.cs" />
    <Compile Include="../Support/ProjectionEventService.cs" Link="Support/ProjectionEventService.cs" />
    <Compile Include="../Support/XoDelivery.cs" Link="Support/XoDelivery.cs" />
  </ItemGroup>
</Project>
