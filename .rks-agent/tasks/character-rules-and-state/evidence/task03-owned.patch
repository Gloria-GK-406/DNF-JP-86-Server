+        HpRegenSpeed = stats.HpRegenSpeed,
+        MpRegenSpeed = stats.MpRegenSpeed,
+        MoveSpeed = stats.MoveSpeed,
+        AttackSpeed = stats.AttackSpeed,
+        CastSpeed = stats.CastSpeed,
+        HitRecovery = stats.HitRecovery,
+        JumpPower = stats.JumpPower,
+        Weight = stats.Weight,
