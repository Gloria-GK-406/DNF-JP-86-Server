# Build output (never commit local builds)
[Bb]in/
[Oo]bj/
[Dd]ist/
[Pp]ublish/
out/

# IDE / editor (may contain absolute paths)
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.DotSettings.user

# MSBuild / NuGet intermediates (contain machine-specific paths)
project.lock.json
project.fragment.lock.json
artifacts/
TestResults/
*.nuget.props
*.nuget.targets

# Runtime data
*.pvf
!TestAssets/E2E/**/Script.pvf
# Versioned E2E datasets are intentional; active SQLite journals are never materials.
TestAssets/E2E/**/*.db-wal
TestAssets/E2E/**/*.db-shm
# GM item icon packs hold Nexon art (Tool/GmIconPack output): deployment directory only, never the repository.
gm-icons.zip
*.gm-icons.zip
# ...but not the project directory. This repo has core.ignorecase=true, so `*.pvf`
# also matches the folder `Dfo.Pvf`, and everything created inside it becomes
# invisible to `git add` without a word of warning. Git cannot re-include a file
# whose parent directory is excluded, so the directory itself is un-excluded here.
!Server/src/Dfo.Pvf/

# OS
.DS_Store
Thumbs.db

# CRAP 采集结果（Tool/CrapMeter 写入）
# 每次调用在这里新建一个 .crap/<YYYY-MM-DD_HH-mm-ss>/，内容是某一次快照的测量证据，
# 不是源码。历次运行只在本地留存、不进版本库；要保留某次结果就自己另存出去。
# 排除写在这里而不是 .git/info/exclude，是为了让它随仓库分发——
# 不然每个克隆都要各自再排一次，迟早有人把一整份采集提交上来。
.crap/

# Web dependencies
node_modules/
*.tsbuildinfo

# Python tooling caches
__pycache__/
