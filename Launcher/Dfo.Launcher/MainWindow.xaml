<Window x:Class="Dfo.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNF JP 86 Launcher"
        Width="1120" Height="630"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="CaptionButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#D8C99E" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#25395A" />
                <Setter Property="Foreground" Value="#FFF4CB" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#3B2940" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="15,11" />
      <Setter Property="Margin" Value="0,7,0,14" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="#F1F4FA" />
      <Setter Property="CaretBrush" Value="#49C9FF" />
      <Setter Property="Background" Value="#8A0B1729" />
      <Setter Property="BorderBrush" Value="#B8A36A" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="InputPasswordStyle" TargetType="PasswordBox">
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="15,11" />
      <Setter Property="Margin" Value="0,7,0,14" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="#F1F4FA" />
      <Setter Property="CaretBrush" Value="#49C9FF" />
      <Setter Property="Background" Value="#8A0B1729" />
      <Setter Property="BorderBrush" Value="#B8A36A" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="64" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="23" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderBrush" Value="#E0C56F" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#0D47A8" Offset="0" />
                  <GradientStop Color="#087ED2" Offset="0.55" />
                  <GradientStop Color="#05BEE8" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect Color="#37D8FF" BlurRadius="14" ShadowDepth="0" Opacity="0.62" />
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="48" />
      <Setter Property="Foreground" Value="#E9E5D8" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Background" Value="#260B1729" />
      <Setter Property="BorderBrush" Value="#A88F54" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="SecondaryBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SecondaryBorder" Property="Background" Value="#3A23436A" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="SecondaryBorder" Property="Opacity" Value="0.38" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Background="Transparent">
    <Border x:Name="WindowFrame" Margin="14" CornerRadius="10"
            Background="#061120" BorderBrush="#C8AC60" BorderThickness="1.5">
      <Border.Effect>
        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.65" />
      </Border.Effect>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2.05*" />
          <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#13233A">
          <Image x:Name="HeroArtwork"
                 Source="/Dfo.Launcher;component/Assets/launcher-hero.png"
                 Stretch="UniformToFill"
                 StretchDirection="Both" />
          <Border HorizontalAlignment="Right" Width="76">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#00061120" Offset="0" />
                <GradientStop Color="#D9061120" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </Grid>

        <Border Grid.Column="1" Background="#F5071427" BorderBrush="#B89850"
                BorderThickness="1,0,0,0">
          <Grid>
            <Grid.Background>
              <RadialGradientBrush Center="0.45,0.34" GradientOrigin="0.45,0.34" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#172C4A" Offset="0" />
                <GradientStop Color="#071427" Offset="0.58" />
                <GradientStop Color="#040C18" Offset="1" />
              </RadialGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
              <RowDefinition Height="42" />
              <RowDefinition Height="*" />
              <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Border x:Name="DragRegion" Grid.Row="0" Background="Transparent"
                    MouseLeftButtonDown="DragRegion_MouseLeftButtonDown" />
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,5,8,0">
              <Button x:Name="WindowMinimizeButton" Content="—" Style="{StaticResource CaptionButtonStyle}"
                      ToolTip="最小化" Click="Minimize_Click" />
              <Button x:Name="WindowCloseButton" Content="×" Style="{StaticResource CaptionButtonStyle}"
                      ToolTip="关闭" Click="Close_Click" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="52,18,52,8">
              <StackPanel x:Name="FormPanel" VerticalAlignment="Center"
                          Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,34">
                  <Ellipse x:Name="ServerStatusIndicator" Width="11" Height="11" Margin="0,0,11,0">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="#6B7482" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsServerReady}" Value="True">
                            <Setter Property="Fill" Value="#27E88D" />
                            <Setter Property="Effect">
                              <Setter.Value>
                                <DropShadowEffect Color="#27E88D" BlurRadius="13" ShadowDepth="0" Opacity="0.9" />
                              </Setter.Value>
                            </Setter>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                  <TextBlock x:Name="ServerStatusText" Text="{Binding ServerStatusText}"
                             Foreground="#BFD4C9" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock x:Name="HeaderTitle" Text="账号登录" Foreground="#F4E8C5"
                           FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <Border Height="1" Margin="10,20,10,26" Background="#665E4B2B" />

                <TextBlock x:Name="LoginIdLabel" Text="账号" Foreground="#AEBBD0" FontSize="13" />
                <TextBox x:Name="LoginIdBox" Text="{Binding LoginId, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="账号" Style="{StaticResource InputTextBoxStyle}" />
                <TextBlock x:Name="PasswordLabel" Text="密码" Foreground="#AEBBD0" FontSize="13" />
                <PasswordBox x:Name="PasswordInput" AutomationProperties.Name="密码"
                             Style="{StaticResource InputPasswordStyle}" />

                <CheckBox x:Name="RememberCredentialsBox" Content="保存账号和密码"
                          IsChecked="{Binding RememberCredentials}"
                          Foreground="#C9D3E2" Margin="1,1,0,10" Cursor="Hand" />
                <TextBlock x:Name="FieldErrorTextBlock" Text="{Binding FieldErrorText}"
                           Foreground="#FF9EAA" TextWrapping="Wrap" MinHeight="20" Margin="0,0,0,8" />

                <Button x:Name="PrimaryActionButton" Content="进入游戏"
                        IsEnabled="{Binding CanSubmit}" Click="Submit_Click"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button x:Name="RegisterButton" Content="注册账号"
                        IsEnabled="{Binding RegistrationEnabled}" Click="OpenRegistration_Click"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,18,0,0" />
              </StackPanel>

              <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar x:Name="LoadingProgress" Width="220" Height="5" IsIndeterminate="True"
                             Foreground="#20BFF4" Background="#14253D" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="#CAD4E4"
                           Margin="0,18,0,0" HorizontalAlignment="Center" />
              </StackPanel>

              <StackPanel x:Name="ErrorPanel" VerticalAlignment="Center"
                          Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <Ellipse Width="13" Height="13" Fill="#F06068" HorizontalAlignment="Center" Margin="0,0,0,16">
                  <Ellipse.Effect>
                    <DropShadowEffect Color="#F06068" BlurRadius="12" ShadowDepth="0" Opacity="0.8" />
                  </Ellipse.Effect>
                </Ellipse>
                <TextBlock Text="{Binding StatusMessage}" Foreground="#F4E8C5" FontSize="22"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding GlobalError}" Foreground="#D6BFC5" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,13,0,20" LineHeight="21" />
                <Button x:Name="RetryButton" Content="重新检测" Click="Retry_Click"
                        IsEnabled="{Binding CanRetry}" Style="{StaticResource SecondaryButtonStyle}" />
              </StackPanel>
            </Grid>

            <TextBlock Grid.Row="2" Text="DNF JP 86 · LAUNCHER API V1"
                       Foreground="#53647D" FontSize="10" HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
