# The protocol knowledge base is regenerated by protocol/patterns/data/rebuild.py, which
# writes LF. This repository sets core.autocrlf=true, so without this rule a checkout
# converts those files to CRLF and the very next regeneration reports all ~1400 of them as
# modified — destroying the property the scaffold depends on: that it can be rebuilt at any
# time and produce no diff.
#
# Scoped to protocol/ deliberately. It is the only tree with machine-generated content, and
# a repository-wide rule would churn files that no tool rewrites.
protocol/** text eol=lf
