kind: rks-sdd-execution
controller: sdd-standard
contract:
  path: ./TaskContract.md
  revision: 3
current_stage: verification
state: in_progress
artifacts:
  spec: ./spec.md
  result: ./spec-result.md
  plan: ./plan.md
  change_review: ./reviews/change-review-expiry.md
  completion_evidence: ./verification/completion-evidence.md
stages:
- id: spec
  reads:
  - contract
  skills:
  - writing-specs
  gate: none
  done_when: the Spec defines the requested result, scope, and evidence-based acceptance
  writes:
  - spec
- id: plan
  reads:
  - contract
  - spec
  skills:
  - writing-plans
  gate: none
  done_when: the ready high-level Plan uses task-units, covers the whole Spec, and
    defines progressive decomposition and the next planning boundary; task-boundary
    attention control requires mode task-units and progressive detail
  writes:
  - plan
- id: implementation
  reads:
  - plan
  skills:
  - executing-tasks
  - reviewing-work
  - test-driven-development
  gate: auto
  done_when: the chosen planning mode is delivered with usable Task plans and passing
    required self-checks when using units, and no remaining required high-level work;
    brief main-agent goal checks keep work directed; any detected drift has a retrospective
    diagnosis, evidenced onset, and verified bounded correction without routine Task
    approvals
- id: review
  reads:
  - contract
  - spec
  - plan
  skills:
  - reviewing-work
  gate: auto
  done_when: the complete code, non-code, or mixed result is independently approved
    against the governing artifacts and actual output criteria
  writes:
  - change_review
- id: verification
  reads:
  - contract
  - change_review
  skills:
  - verification-before-completion
  gate: hitl
  done_when: fresh evidence proves every TaskContract success condition
  writes:
  - completion_evidence
attention_review: on-drift
tasks:
  items:
  - id: TASK-001
    file: ./tasks/TASK-001-instance.md
    depends_on: []
    state: done
  - id: TASK-002
    file: ./tasks/TASK-002-rules-and-migration.md
    depends_on:
    - TASK-001
    state: done
  - id: TASK-003
    file: ./tasks/TASK-003-integration-and-acceptance.md
    depends_on:
    - TASK-002
    state: done
  - id: TASK-004
    file: ./tasks/TASK-004-reinforcement-field-repair.md
    depends_on:
    - TASK-003
    state: done
  - id: TASK-005
    file: ./tasks/TASK-005-protection.md
    depends_on:
    - TASK-004
    state: done
  - id: TASK-006
    file: ./tasks/TASK-006-probability-diagnosis.md
    depends_on:
    - TASK-005
    state: done
  - id: TASK-007
    file: ./tasks/TASK-007-protection-expiry.md
    depends_on:
    - TASK-006
    state: done
